generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for app queries (serverless-friendly).
  url       = env("DATABASE_URL")
  // Direct connection for migrations — Neon's pooler can't run them.
  directUrl = env("DATABASE_DIRECT_URL")
}

// One saved investigation, scoped to the GitHub login of the session that ran it.
// `result` holds the full DigResult so a case reopens exactly as it was concluded.
model Investigation {
  id        String   @id @default(cuid())
  userLogin String
  caseId    String
  question  String
  repoPath  String
  location  String
  result    Json
  createdAt DateTime @default(now())

  @@unique([userLogin, caseId])
  @@index([userLogin, createdAt])
}
