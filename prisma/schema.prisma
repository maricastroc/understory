generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model Investigation {
  id        String   @id @default(cuid())
  userLogin String
  caseId    String
  question  String
  repoPath  String
  location  String
  result    Json
  createdAt DateTime @default(now())

  @@unique([userLogin, caseId])
  @@index([userLogin, createdAt])
}

model QuestionLog {
  id         String   @id @default(cuid())
  question   String
  repoPath   String
  location   String?
  anchorKind String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
