# On-prem config for the single-container deploy (docker-compose.yml).
# Copy to .env.on-prem (gitignored, and kept out of the Docker build context),
# fill it in, then:
#   docker compose --env-file .env.on-prem up -d --build

# --- required: private GitLab ---
# Personal, project or group access token with `read_api` + `read_repository`,
# created on the same GitLab instance.
GITLAB_TOKEN=
# Comma-separated self-hosted GitLab hostnames, e.g. gitlab.company.com
# (gitlab.com is always recognized).
GITLAB_HOSTS=

# --- recommended: the project the app opens on load (baked in at BUILD time) ---
# e.g. https://gitlab.company.com/group/project. When empty, the app opens on the
# local demo path, which does not exist in the image, so it shows "Not a git
# repository" and asks for one.
NEXT_PUBLIC_DEFAULT_REPO=

# --- optional: LLM narrative. Get a free key at https://console.groq.com/keys ---
# Without it, investigations still return evidence + the provenance chain.
GROQ_API_KEY=

# --- optional: also investigate GitHub repos from the same instance ---
GITHUB_TOKEN=

# --- optional: Postgres for case history ---
# Case history is saved per signed-in user, and sign-in (GitHub OAuth) is not
# configured in this image, so on-prem cases stay in the browser session. The
# bundled Postgres (`--profile db`) and `prisma migrate deploy` only prepare the
# schema:
# DATABASE_URL=postgresql://gi:gi@db:5432/git_investigator
# DATABASE_DIRECT_URL=postgresql://gi:gi@db:5432/git_investigator

# --- optional: split deploy (see .env.example) ---
# Only when this container is the collector behind a public UI: the public
# instance sends this secret, and requests without it are rejected.
# COLLECTOR_INBOUND_SECRET=
