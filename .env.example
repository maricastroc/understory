# Copy this file to .env.local and fill in your keys. .env.local is gitignored.

# Groq free tier — create a key (no credit card) at:
#   https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the synthesis model (defaults to openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: model for the entailment auditor (the ~8 judge-and-quote calls per
# investigation). Defaults to openai/gpt-oss-20b — same family as synthesis, ~half
# the price and ~2x the speed. Drop to llama-3.1-8b-instant for max savings, or set
# it to openai/gpt-oss-120b to run everything on one model.
# GROQ_AUDIT_MODEL=openai/gpt-oss-20b

# Optional: set to 0 to skip the entailment audit. Citations are then only checked
# for existence, and confidence is capped at medium.
# ENTAILMENT=0

# GitHub token — needed for line-level history (blame uses the GraphQL API,
# which requires auth) and for private repos. Create a classic token with the
# `repo` scope (or `public_repo` for public only) at:
#   https://github.com/settings/tokens/new
GITHUB_TOKEN=

# Optional: depth of the shallow clone used for remotes that are neither GitHub nor
# GitLab (defaults to 150). Deeper clones recover more of a line's history.
# CLONE_DEPTH=150

# The default repo the app opens on load. Local dev can use the seeded git demo
# (.demo/payments-service via `npm run seed:demo`); production must point at a
# public GitHub repo, since the local git demo can't run on serverless.
# NEXT_PUBLIC_DEFAULT_REPO=https://github.com/fontsource/fontsource

# --- GitHub OAuth (optional — "Sign in with GitHub") ---
# Create an OAuth App at https://github.com/settings/developers with callback URL
#   <your-app-origin>/api/auth/callback   (e.g. http://localhost:3000/api/auth/callback)
# The client id is public; the secret and AUTH_SECRET are server-only.
# Leave NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID unset to hide the sign-in button.
# NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# AUTH_SECRET=            # any long random string, e.g. `openssl rand -hex 32`

# --- GitHub App (optional — private/org repos without pasting a token) ---
# Create an App at https://github.com/settings/apps/new with repository read
# permissions: Contents, Pull requests, Issues, Metadata. Generate a private key
# (.pem) and install the App on the account/org whose private repos you'll use.
# When set, the server mints short-lived installation tokens per repo — no PAT
# needed. Falls back to a user-supplied token or GITHUB_TOKEN when unset.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=            # the app's URL slug, for the "install it" link
# GITHUB_APP_PRIVATE_KEY=     # the .pem contents; escape newlines as \n on one line

# --- Investigation history (optional) ---
# A Postgres connection string. When set, signed-in users' investigations are
# saved and restored across sessions/devices; leave it unset and history stays
# in memory for the session only. After setting it, run:  npx prisma migrate dev
# Local: postgresql://user:pass@localhost:5432/git_investigator
# Hosted (Neon/Supabase/etc.): use the pooled connection string they give you.
# DATABASE_URL=

# Direct (non-pooled) connection, used by Prisma for migrations. On a local
# Postgres this is the same as DATABASE_URL; on pooled hosts use their direct URL.
# DATABASE_DIRECT_URL=

# --- Private GitLab (optional) ---
# Reaching a private/self-hosted GitLab has two parts: auth (a token) and network
# reach (the app must sit where it can open a connection to the GitLab host).
# The on-prem Docker container (docker-compose.yml) is configured through
# .env.on-prem — see .env.on-prem.example.
#
# GitLab Personal/Project Access Token with `read_api` + `read_repository`.
# Set this on whichever instance actually talks to GitLab (see the two roles
# below). The token never needs to leave that network.
# GITLAB_TOKEN=
#
# Comma-separated self-hosted GitLab hostnames to recognize as GitLab (gitlab.com
# is always recognized). Set on the instance that runs the GitLab adapter.
# GITLAB_HOSTS=gitlab.company.com
#
# --- Split deploy: Vercel UI + on-prem collector (optional) ---
# When GitLab is behind a firewall, Vercel can't reach it directly. Run the on-prem
# Docker container INSIDE the network (the "collector") and let the Vercel instance
# forward repository, file, blame, history and investigation requests to it through
# an outbound tunnel (Cloudflare Tunnel / Tailscale) or Vercel Enterprise Secure
# Compute. The GitHub path is unaffected — only hosts in COLLECTOR_HOSTS are delegated.
#
# On the VERCEL instance (public UI, forwards to the collector):
#   COLLECTOR_URL=https://collector.company.com   # reachable endpoint of the tunnel
#   COLLECTOR_HOSTS=gitlab.company.com            # hosts to route to the collector
#   COLLECTOR_SECRET=<shared secret>              # sent on every delegated request
#
# On the COLLECTOR instance (the on-prem container, configured in .env.on-prem with
# GITLAB_TOKEN/GITLAB_HOSTS; DO NOT set COLLECTOR_URL/COLLECTOR_HOSTS there so it
# handles requests in-process):
#   COLLECTOR_INBOUND_SECRET=<same shared secret> # rejects requests without it

# --- Rate limiting (optional, recommended in production) ---
# Upstash Redis (REST) — per-IP limits on the routes that spend the owner's LLM /
# GitHub quota (/api/dig, /api/explain-diff, /api/repo, /api/file, /api/blame,
# /api/overview, /api/history-map), and a 90-day cache of the composer's history map.
# Create a free database at https://console.upstash.com and paste its REST URL +
# token. When BOTH are unset, rate limiting fails open (every request passes) and the
# history map is cached in memory — fine for local dev.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
